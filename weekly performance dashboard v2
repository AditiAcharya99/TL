 filtered().forEach(r=>{const div=document.createElement('div');div.className='card';
  div.innerHTML=`<div class="who">${r.name}<small>${r.team}</small></div>`+
   D.stats.map(s=>`<div class="cell">${spark(r.series[s.key],s.key)}</div>`).join('');
  rows.appendChild(div);});
}
function tableRows(){const out=[];
 filtered().forEach(r=>D.weeks.forEach((wk,i)=>out.push(
   [r.name,r.team,wk,...D.stats.map(s=>r.series[s.key][i])]))); return out;}
function renderTable(){
 const head=['Recruiter','Team','Week starting',...D.stats.map(s=>s.label)];
 let h='<thead><tr>'+head.map((x,j)=>`<th class="${j>2?'r':''}">${x}</th>`).join('')+'</tr></thead><tbody>';
 h+=tableRows().map(row=>'<tr>'+row.map((c,j)=>`<td class="${j>2?'r':''}">${c}</td>`).join('')+'</tr>').join('');
 document.getElementById('tbl').innerHTML=h+'</tbody>';
}
document.getElementById('dl').addEventListener('click',()=>{
 const head=['Recruiter','Team','Week starting',...D.stats.map(s=>s.key)];
 const esc=v=>`"${String(v).replace(/"/g,'""')}"`;
 const csv=[head.map(esc).join(',')].concat(tableRows().map(r=>r.map(esc).join(','))).join('\n');
 const a=document.createElement('a');
 a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv'}));
 a.download=`weekly_${sel.value}.csv`; a.click();
});
function render(){renderSummary();renderRows();renderTable();}
sel.addEventListener('change',render); render();
</script></body></html>
