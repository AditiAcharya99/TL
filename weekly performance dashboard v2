function spark(vals,statKey,maxV,mode){
 const W=240,H=86,ml=26,mr=8,mt=17,mb=16,iw=W-ml-mr,ih=H-mt-mb;
 const max=maxV||D.maxes[statKey]||1,n=vals.length,dm=D.demarc;
 const X=i=>ml+(n<=1?0:iw*i/(n-1)), Y=v=>mt+ih*(1-v/max);
 const pre=vals.slice(0,dm),post=vals.slice(dm);
 const psum=pre.reduce((a,b)=>a+b,0), posum=post.reduce((a,b)=>a+b,0);
 const pm=pre.length?psum/pre.length:0, pom=post.length?posum/post.length:0;
 const col=pom>pm?'#2ca02c':pom<pm?'#d62728':'#c2c6cc';
 const cls=pom>pm?'up':pom<pm?'down':'flat';
 const all=vals.map((v,i)=>`${X(i).toFixed(1)},${Y(v).toFixed(1)}`).join(' ');
 let ps=[];for(let i=Math.max(0,dm-1);i<n;i++)ps.push(`${X(i).toFixed(1)},${Y(vals[i]).toFixed(1)}`);
 const dmx=(X(dm)-((n>1)?iw/(n-1)/2:0));
 const del = mode==='both'
   ? `total <b>${psum}</b>&rarr;<span class="${cls}">${posum}</span> &nbsp;&middot;&nbsp; per week <b>${pm.toFixed(1)}</b>&rarr;<span class="${cls}">${pom.toFixed(1)}</span>`
   : `per week <b>${pm.toFixed(1)}</b> &rarr; <span class="${cls}">${pom.toFixed(1)}</span>`;
 return `<svg viewBox="0 0 ${W} ${H}" width="100%" preserveAspectRatio="xMidYMid meet" style="height:auto;display:block">
  <rect x="${dmx.toFixed(1)}" y="${mt}" width="${(W-mr-dmx).toFixed(1)}" height="${ih}" fill="#000" opacity="0.04"/>
  <line x1="${dmx.toFixed(1)}" y1="${mt}" x2="${dmx.toFixed(1)}" y2="${mt+ih}" stroke="#444" stroke-dasharray="3,2"/>
  <text x="${dmx.toFixed(1)}" y="11" font-size="8" fill="#444" text-anchor="middle">${D.demarcLabel}</text>
  <polyline points="${all}" fill="none" stroke="#b8bcc2" stroke-width="1.2"/>
  <polyline points="${ps.join(' ')}" fill="none" stroke="${col}" stroke-width="2.4"/>
  <text x="2" y="${mt+6}" font-size="9" fill="#8a929e">${max}</text>
  <text x="2" y="${mt+ih}" font-size="9" fill="#8a929e">0</text>
  <text x="${ml}" y="${H-3}" font-size="8.5" fill="#8a929e">${D.weeks[0]}</text>
  <text x="${W-mr}" y="${H-3}" font-size="8.5" fill="#8a929e" text-anchor="end">${D.weeks[n-1]}</text>
  </svg>
  <div class="delta">${del}</div>`;
}
function filtered(){const t=sel.value;return D.recruiters.filter(r=>t==='All'||r.team===t);}
