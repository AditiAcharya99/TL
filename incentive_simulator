  const totalNewRev = n.baseRevImproved + n.nnRevCum;
  const totalYOnBase = n.recYOnBase + n.mgmtYOnBase;
  const totalYOnExtra = n.recYOnExtra + n.mgmtYOnExtra + n.nnYMonthly; // nn only exists in extra month
  const totalYCum = n.recYCum + n.mgmtYCum + n.nnYCum;
  const totalDeltaCost = totalYCum + n.zCost + n.nnXCost;
  const totalNewCost = SQ.grand + totalDeltaCost;
  const newProfit = totalNewRev - totalNewCost;
  const dProfit = newProfit - SQ.margin;
  const pos = dProfit >= 0;

  // All-placements scenario
  const allYCum = n.allRecYCum + n.allMgmtYCum + n.nnYCum;
  const allDeltaCost = allYCum + n.zCost + n.nnXCost;
  const allNewCost = SQ.grand + allDeltaCost;
  const allNewProfit = totalNewRev - allNewCost;
  const allDProfit = allNewProfit - SQ.margin;
  const allPos = allDProfit >= 0;

  // Monthly rates
  const totalYMonthly = n.recYMonthly + n.mgmtYMonthly + n.nnYMonthly;

  const avgMU = avgMarkup();
  const avgY = weightedAvgY(yVals);

  const zLabels = {1:'full base rate', 0.667:'2/3 of base', 0.5:'half of base', 0.333:'1/3 of base'};

  document.getElementById('result-area').innerHTML = `
    <div class="result-card">
      <div class="result-title">Proposed Scheme: Current Base + Retention Bonus + Sourcing Bonus</div>
      <div class="result-sub">${state.y1===state.y2&&state.y2===state.y3 ? 'Retention bonus = \u20B9'+state.y1+'/month per placement (flat across slabs)' : 'Retention bonus = \u20B9'+state.y1+'/\u20B9'+state.y2+'/\u20B9'+state.y3+' per month (Slab 1/2/3)'} · Sourcing bonus = ${zLabels[state.zFactor]||'half of base'}<br>${n.elCount} of ${REC.length} recruiters meet target (${n.elPRs} of ${TOTAL_NPL} placements eligible for incentives) · Current monthly incentive payout: ${fmt(SQ.grand)}</div>

      <div class="delta-box ${pos?'pos':'neg'}">
        <div class="delta-label">Change in Profit vs Current Scheme (eligible placements only)</div>
        <div class="delta-value ${pos?'pos':'neg'}">${fmtD(dProfit)}</div>
        <div class="delta-aside">Proposed profit: ${fmt(newProfit)} (current: ${fmt(SQ.margin)})</div>
      </div>

      <!-- INCREMENTAL MONTH -->
      <div class="section-box">
        <div class="section-box-title">The Extra Month of Retention</div>
        <div class="section-box-note">If workers stay 1 additional month on average, the firm earns 1 extra month of markup. This is the revenue gain that funds the retention bonus.</div>
        <div class="decomp-row"><span class="dl">Markup revenue earned in the extra month (across all ${TOTAL_NPL} placements)</span><span class="dv pos">${fmtD(retRevGain)}</span></div>
        <div class="decomp-row"><span class="dl">Retention bonus paid in the extra month (eligible placements + TLs + Managers)</span><span class="dv neg">-${fmt(totalYOnExtra)}</span></div>
        <div class="decomp-divider"></div>
        <div class="decomp-row total"><span class="dl">Net gain from the extra month</span><span class="dv ${(retRevGain-totalYOnExtra)>=0?'pos':'neg'}">${fmtD(retRevGain - totalYOnExtra)}</span></div>

        <div class="punchline ${(retRevGain-totalYOnExtra)>=0?'':'warning'}">
          <strong>Per eligible placement:</strong> the firm earns <strong>\u20B9${Math.round(avgMU)}</strong> in markup in the extra month and pays <strong>\u20B9${avgY.toFixed(0)}</strong> in retention bonus — a net gain of <strong>\u20B9${Math.round(avgMU - avgY)}</strong> per placement.
          ${avgMU > avgY ? 'The extra month is profitable for any retention bonus below \u20B9'+Math.round(avgMU)+'/month.' : ''}
        </div>
      </div>

      <!-- BASE MONTHS -->
      <div class="section-box">
        <div class="section-box-title">Retention Bonus on Base Months</div>
        <div class="section-box-note">The retention bonus is paid for every month the worker stays — including the months they would have stayed anyway under the current scheme. This is a pure cost increase with no matching revenue.</div>
        <div class="decomp-row"><span class="dl">Recruiter retention bonus on base tenure (${n.elPRs} eligible placements)</span><span class="dv neg">-${fmt(n.recYOnBase)}</span></div>
        <div class="decomp-row"><span class="dl">TL &amp; Manager retention bonus on base tenure</span><span class="dv neg">-${fmt(n.mgmtYOnBase)}</span></div>
        <div class="decomp-divider"></div>
        <div class="decomp-row total"><span class="dl">Total retention bonus on base months</span><span class="dv neg">-${fmt(totalYOnBase)}</span></div>

        <div class="punchline">
          <strong>This is the real cost of the retention bonus.</strong> The average eligible placement has a base tenure of ~${avgBaseTenure().toFixed(1)} months, so each placement incurs ~\u20B9${Math.round(avgY * avgBaseTenure())} in retention bonus on months where the worker would have stayed regardless. This cost is offset if the extra month's markup gain is large enough.
        </div>
      </div>

      <!-- ONE-TIME COSTS -->
      <div class="section-box">
        <div class="section-box-title">One-Time Costs at Placement</div>
        <div class="section-box-note">Paid once when the placement happens. The per-placement base incentive is unchanged from the current scheme.</div>
        <div class="decomp-row"><span class="dl">Per-placement base incentive (unchanged from current scheme)</span><span class="dv zero">\u20B90</span></div>
        <div class="decomp-row"><span class="dl">Sourcing bonus on cross-recruiter placements (5% of all ${TOTAL_NPL} placements = ${Math.round(n.totNN*2)})</span><span class="dv neg">${n.zCost>0.5?'-'+fmt(n.zCost):'\u20B90'}</span></div>
        <div class="decomp-row"><span class="dl">Base incentive on net new placements (${Math.round(n.totNN)} additional PRs)</span><span class="dv neg">${n.nnXCost>0.5?'-'+fmt(n.nnXCost):'\u20B90'}</span></div>
        <div class="decomp-divider"></div>
        <div class="decomp-row total"><span class="dl">Total one-time cost increase</span><span class="dv neg">-${fmt(n.zCost+n.nnXCost)}</span></div>
      </div>

      <!-- CUMULATIVE -->
      <div class="section-box">
        <div class="section-box-title">Cumulative Impact</div>
        <div class="section-box-note">All components combined: extra-month revenue, retention bonus across all months, one-time sourcing costs, and net new placement effects.</div>
        <div class="decomp-row"><span class="dl">Markup revenue from extra month of retention</span><span class="dv pos">${fmtD(retRevGain)}</span></div>
        <div class="decomp-row"><span class="dl">Revenue from net new placements (${Math.round(n.totNN)} PRs)</span><span class="dv ${n.nnRevCum>0.5?'pos':'neutral'}">${n.nnRevCum>0.5?fmtD(n.nnRevCum):'\u20B90'}</span></div>
        <div class="decomp-divider"></div>
        <div class="decomp-row"><span class="dl">Retention bonus — on base months (pure cost)</span><span class="dv neg">-${fmt(totalYOnBase)}</span></div>
        <div class="decomp-row"><span class="dl">Retention bonus — on extra month</span><span class="dv neg">-${fmt(totalYOnExtra)}</span></div>
        <div class="decomp-row"><span class="dl">Retention bonus — on net new placements</span><span class="dv ${n.nnYCum>0.5?'neg':'neutral'}">${n.nnYCum>0.5?'-'+fmt(n.nnYCum):'\u20B90'}</span></div>
        <div class="decomp-row"><span class="dl">One-time costs (sourcing bonus + net new base)</span><span class="dv neg">-${fmt(n.zCost+n.nnXCost)}</span></div>
        <div class="decomp-divider"></div>
        <div class="decomp-row total"><span class="dl">Change in profit (eligible placements only)</span><span class="dv ${pos?'pos':'neg'}" style="font-size:16px">${fmtD(dProfit)}</span></div>
      </div>

      <!-- ALL PLACEMENTS COMPARISON -->
      <div class="section-box" style="border-color:var(--border-active)">
        <div class="section-box-title">If Retention Bonus Covered All Placements</div>
        <div class="section-box-note">The firm earns markup on all ${n.allPRs} placements, not just the ${n.elPRs} from target-eligible recruiters. This shows the cost and profit impact if the retention bonus were paid on every placement regardless of whether the recruiter met their target.</div>
        <div class="decomp-row"><span class="dl">Retention bonus across all recruiter placements</span><span class="dv neg">-${fmt(n.allRecYCum)}</span></div>
        <div class="decomp-row"><span class="dl">Retention bonus across all TLs &amp; Managers</span><span class="dv neg">-${fmt(n.allMgmtYCum)}</span></div>
        <div class="decomp-row"><span class="dl">Retention bonus on net new placements</span><span class="dv ${n.nnYCum>0.5?'neg':'neutral'}">${n.nnYCum>0.5?'-'+fmt(n.nnYCum):'\u20B90'}</span></div>
        <div class="decomp-row"><span class="dl">One-time costs (sourcing bonus + net new base)</span><span class="dv neg">-${fmt(n.zCost+n.nnXCost)}</span></div>
        <div class="decomp-divider"></div>
        <div class="decomp-row"><span class="dl">Total additional cost (all placements)</span><span class="dv neg">-${fmt(allDeltaCost)}</span></div>
        <div class="decomp-row"><span class="dl">Total additional revenue (unchanged — same for both)</span><span class="dv pos">${fmtD(retRevGain + n.nnRevCum)}</span></div>
        <div class="decomp-divider"></div>
        <div class="decomp-row total"><span class="dl">Change in profit (all placements)</span><span class="dv ${allPos?'pos':'neg'}" style="font-size:16px">${fmtD(allDProfit)}</span></div>

        <div class="punchline ${allPos?'':'warning'}" style="margin-top:10px">
          <strong>Comparison:</strong> Paying retention bonus on eligible placements only: <span class="${pos?'val-green':'val-red'}">${fmtD(dProfit)}</span>. Paying on all placements: <span class="${allPos?'val-green':'val-red'}">${fmtD(allDProfit)}</span>. Difference: <span class="val-${(allDProfit-dProfit)>=0?'green':'red'}">${fmtD(allDProfit - dProfit)}</span> (${n.allPRs - n.elPRs} additional placements covered).
        </div>
      </div>

      <div class="totals-grid">
        <div class="total-item"><div class="ti-label">Proposed Total Cost (eligible)</div><div class="ti-value">${fmt(totalNewCost)}</div></div>
        <div class="total-item"><div class="ti-label">Proposed Revenue</div><div class="ti-value">${fmt(totalNewRev)}</div></div>
        <div class="total-item"><div class="ti-label">Proposed Profit (eligible)</div><div class="ti-value" style="color:${newProfit>=0?'var(--green)':'var(--red)'}">${fmt(newProfit)}</div></div>
      </div>
    </div>`;
}

function updateSliderDisplay(id, val, avgX) {
  document.getElementById(id).innerHTML = '\u20B9'+val+' <span class="slider-pct">('+Math.round(val/avgX*100)+'% of base)</span>';
}

document.getElementById('y1').addEventListener('input', e => { state.y1=+e.target.value; updateSliderDisplay('y1-val',state.y1,140); render(); });
document.getElementById('y2').addEventListener('input', e => { state.y2=+e.target.value; updateSliderDisplay('y2-val',state.y2,187.5); render(); });
document.getElementById('y3').addEventListener('input', e => { state.y3=+e.target.value; updateSliderDisplay('y3-val',state.y3,275); render(); });

document.querySelectorAll('.toggle-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const g=btn.dataset.group;
    document.querySelectorAll('.toggle-btn[data-group="'+g+'"]').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active');
    state.zFactor = parseFloat(btn.dataset.val);
    render();
  });
});

updateSliderDisplay('y1-val',state.y1,140);
updateSliderDisplay('y2-val',state.y2,187.5);
updateSliderDisplay('y3-val',state.y3,275);
render();
</script>
</body>
</html>
