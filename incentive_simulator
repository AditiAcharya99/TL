const EXTRA_MONTHS = 1, CROSS_PCT = 5, NET_NEW_PCT = 50;
const AVG_X = {1:140, 2:187.5, 3:275};
const BOUNDS = {
  "Enterprise BFSI":[35,70], "Enterprise Consumer+":[35,70], "Enterprise Airtel":[30,60],
  "Corporate South":[25,50], "Corporate N&E":[25,50], "Corporate West":[25,50]
};

function slabSplit(count, bounds) {
  return [Math.min(count,bounds[0]), Math.min(Math.max(count-bounds[0],0),bounds[1]-bounds[0]), Math.max(count-bounds[1],0)];
}
function mgmtSlab(p) {
  if (p.d==='E') return p.avg_prod<=60?1:p.avg_prod<=70?2:3;
  return p.avg_prod<=45?1:p.avg_prod<=60?2:3;
}
function fmt(n) {
  if (Math.abs(n)>=100000) return '\u20B9'+(n/100000).toFixed(2)+'L';
  if (Math.abs(n)>=1000) return '\u20B9'+(n/1000).toFixed(1)+'K';
  return '\u20B9'+Math.round(n);
}
function fmtD(n) {
  const s=n>=0?'+':'';
  if (Math.abs(n)>=100000) return s+'\u20B9'+(n/100000).toFixed(2)+'L';
  if (Math.abs(n)>=1000) return s+'\u20B9'+(n/1000).toFixed(1)+'K';
  return s+'\u20B9'+Math.round(n);
}

// ─── Status Quo ───
function computeSQ() {
  let recCost=0, rev=0, elCount=0, elPRs=0;
  REC.forEach(r => {
    rev += r.mm*r.tm*r.npl + r.sr;
    if (r.tp>=r.t && r.npl>0) { elCount++; elPRs+=r.npl; recCost+=r.cp; }
  });
  let tlCost=0, mgrCost=0;
  TEAMS.forEach(t => { if (!t.el) return; if (t.level==='TL') tlCost+=t.cp; else mgrCost+=t.cp; });
  const mgmtCost=tlCost+mgrCost, grand=recCost+mgmtCost;
  return {recCost,tlCost,mgrCost,mgmtCost,grand,rev,margin:rev-grand,elCount,elPRs};
}

// ─── New Scheme ───
function computeNew(yVals, zFac) {
  const y=yVals;
  // Monthly rates (per month, not multiplied by tenure)
  let recYMonthly=0, nnYMonthly=0, markupEligible=0, markupNN=0, markupAll=0;
  // Decomposed cumulative
  let recYOnBase=0, recYOnExtra=0, recYCum=0;
  let nnYCum=0, nnXCost=0, zCost=0, nnRevCum=0, baseRevImproved=0;
  let elCount=0, elPRs=0, totNN=0;
  // All-placements y (ignoring eligibility)
  let allRecYMonthly=0, allRecYOnBase=0, allRecYOnExtra=0, allRecYCum=0, allPRs=0;

  REC.forEach(r => {
    if (r.npl===0) return;
    const isEl = r.tp>=r.t;
    const impT = Math.min(r.tm + EXTRA_MONTHS, 12);
    const sfPP = r.npl>0 ? r.sr/r.npl : 0;
    baseRevImproved += r.mm*impT*r.npl + r.sr;
    markupAll += r.mm * r.npl;

    // All-placements y (regardless of eligibility)
    if (r.npl > 0) {
      const boundsAll = BOUNDS[r.v]||[25,50];
      const [asf1,asf2,asf3] = slabSplit(r.ps, boundsAll);
      const [ans1,ans2,ans3] = slabSplit(r.pn, boundsAll);
      const an1=asf1+ans1, an2=asf2+ans2, an3=asf3+ans3;
      const aym = an1*y[1] + an2*y[2] + an3*y[3];
      allRecYMonthly += aym;
      allRecYOnBase += aym * r.tm;
      allRecYOnExtra += aym * Math.min(EXTRA_MONTHS, 12 - r.tm > 0 ? EXTRA_MONTHS : 0);
      allRecYCum += aym * impT;
      allPRs += r.npl;
    }

    // Cross-sourcing — applies to ALL placements, not just eligible
    const nCross = r.npl * CROSS_PCT/100;
    const nNN = nCross * NET_NEW_PCT/100;
    totNN += nNN;
    const avgX = AVG_X[r.sl]||AVG_X[1];
    zCost += nCross * avgX * zFac;
    nnXCost += nNN * avgX;
    const nnYm = nNN * y[r.sl];
    nnYMonthly += nnYm;
    nnYCum += nnYm * impT;
    markupNN += nNN * r.mm;
    nnRevCum += nNN * (r.mm*impT + sfPP);

    if (!isEl) return;
    elCount++; elPRs+=r.npl;

    const bounds = BOUNDS[r.v]||[25,50];
    const [sf1,sf2,sf3] = slabSplit(r.ps, bounds);
    const [ns1,ns2,ns3] = slabSplit(r.pn, bounds);
    const n1=sf1+ns1, n2=sf2+ns2, n3=sf3+ns3;

    // Monthly y rate for this recruiter's placements
    const yMonthly = n1*y[1] + n2*y[2] + n3*y[3];
    recYMonthly += yMonthly;
    recYOnBase += yMonthly * r.tm;
    recYOnExtra += yMonthly * Math.min(EXTRA_MONTHS, 12 - r.tm > 0 ? EXTRA_MONTHS : 0);
    recYCum += yMonthly * impT;

    // Monthly markup on eligible placements
    markupEligible += r.mm * r.npl;
  });

  // TL/Manager
  let tlYMonthly=0, mgrYMonthly=0, tlYCum=0, mgrYCum=0, mgmtYOnBase=0, mgmtYOnExtra=0;
  let allMgmtYCum=0, allMgmtYOnBase=0, allMgmtYOnExtra=0, allMgmtYMonthly=0;
  TEAMS.forEach(t => {
    const sl = mgmtSlab(t);
    const impT = Math.min(t.avg_tm + EXTRA_MONTHS, 12);
    const cappedPR = Math.min(t.pr, 100);
    const ym = y[sl] * cappedPR;
    const yBase = ym * t.avg_tm;
    const yExtra = ym * Math.min(EXTRA_MONTHS, 12 - t.avg_tm > 0 ? EXTRA_MONTHS : 0);
    // All TL/Mgr (regardless of eligibility)
    allMgmtYMonthly += ym;
    allMgmtYOnBase += yBase;
    allMgmtYOnExtra += yExtra;
    allMgmtYCum += ym * impT;
    // Eligible only
    if (!t.el) return;
    mgmtYOnBase += yBase;
    mgmtYOnExtra += yExtra;
    if (t.level==='TL') { tlYMonthly+=ym; tlYCum+=ym*impT; }
    else { mgrYMonthly+=ym; mgrYCum+=ym*impT; }
  });

  const mgmtYMonthly = tlYMonthly+mgrYMonthly;
  const mgmtYCum = tlYCum+mgrYCum;

  return {
    recYMonthly, recYCum, recYOnBase, recYOnExtra,
    mgmtYMonthly, mgmtYCum, mgmtYOnBase, mgmtYOnExtra, tlYMonthly, mgrYMonthly, tlYCum, mgrYCum,
    nnYMonthly, nnYCum,
    markupAll, markupEligible, markupNN,
    zCost, nnXCost, nnRevCum,
    baseRevImproved, elCount, elPRs, totNN, allPRs,
    allRecYMonthly, allRecYOnBase, allRecYOnExtra, allRecYCum,
    allMgmtYMonthly, allMgmtYOnBase, allMgmtYOnExtra, allMgmtYCum
  };
}

// Helpers
function avgMarkup() {
  let s=0,n=0; REC.forEach(r=>{if(r.npl>0){s+=r.mm*r.npl;n+=r.npl;}}); return n>0?s/n:0;
}
function weightedAvgY(yVals) {
  let sY=0,sN=0;
  REC.forEach(r=>{
    if(r.tp<r.t||r.npl===0) return;
    const b=BOUNDS[r.v]||[25,50];
    const [a,c,d]=slabSplit(r.ps,b);const [e,f,g]=slabSplit(r.pn,b);
    const n1=a+e,n2=c+f,n3=d+g;
    sY+=n1*yVals[1]+n2*yVals[2]+n3*yVals[3]; sN+=n1+n2+n3;
  });
  return sN>0?sY/sN:0;
}
function avgBaseTenure() {
  let sT=0,sN=0;
  REC.forEach(r=>{
    if(r.tp<r.t||r.npl===0) return;
    sT+=r.tm*r.npl; sN+=r.npl;
  });
  return sN>0?sT/sN:0;
}

